// Witness: the yoga rules find what their definitions say, on placements laid out by hand.
//
//   Grahas are Sun Moon Mars Mercury Jupiter Venus Saturn Rahu Ketu; signs 0 to 11.
//   einstein: the signs of 14 March 1879 with Mithuna rising hold Pravrajya (four grahas in Meena),
//             Dharma-karmadhipati (Saturn and Jupiter exchanged), Kahala, Kedara (four signs), Daridra
//   movable:  all seven in movable signs is Rajju, and no yoga of number is read beside it
//   boat:     one graha in each of the seven houses from the lagna is Nauka
//   cart:     the Moon in the 8th from Jupiter, away from the angles, is Shakata
//   teachers: Mercury, Jupiter and Venus in angles with Jupiter in its own sign is Saraswati, and Mala
//   ./fkwu witness/yoga-run.bml   ->  one verdict line
import engine/num.bml;
import engine/strength.bml;
import engine/yoga.bml;
section [form.bml] {
 def wy-has(ys, name) = !nil?(ys |> filter(y => (String) y[0] == name));
 def wy-all(xs) = nil?(xs) ? true : xs[0] && wy-all(xs[1:]);
 def wy-lons(s) = s |> map(x => x * 30.0 + 10.0);
 def wy-read(s, asc) = yg-yogas(s, wy-lons(s), asc);
 def wy-run() {
  let einstein = wy-read([11, 7, 9, 11, 10, 11, 11, 9, 3], 2);
  let movable = wy-read([0, 3, 6, 9, 0, 3, 6, 1, 7], 0);
  let boat = wy-read([0, 1, 2, 3, 4, 5, 6, 8, 2], 0);
  let cart = wy-read([2, 11, 5, 2, 4, 1, 8, 6, 0], 0);
  let teachers = wy-read([1, 2, 4, 5, 8, 11, 10, 5, 11], 2);
  let claims = [
   wy-has(einstein, "Pravrajya yoga") && wy-has(einstein, "Dharma-karmadhipati yoga") && wy-has(einstein, "Kahala yoga") && wy-has(einstein, "Kedara yoga") && wy-has(einstein, "Daridra yoga"),
   wy-has(movable, "Rajju yoga") && !wy-has(movable, "Kedara yoga") && !wy-has(movable, "Musala yoga"),
   wy-has(boat, "Nauka yoga") && !wy-has(boat, "Veena yoga"),
   wy-has(cart, "Shakata yoga") && !wy-has(einstein, "Shakata yoga"),
   wy-has(teachers, "Saraswati yoga") && wy-has(teachers, "Mala yoga")];
  let held = len(claims |> filter(c => c));
  "yoga witness: " + (held == len(claims) ? "green" : "red") + " " + value_str(held) + " of " + value_str(len(claims)) + " claims " + value_str(claims);
 }
 print_str(wy-run());
}
